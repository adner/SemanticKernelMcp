@page
@model LlmBenchmark.Pages.FrameModel
@{
    ViewData["Title"] = "Frame";
}

<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
         background-color: cadetblue;
    }
</style>

<div style="display: flex; justify-content: center; padding: 8px;">
    <img src="/images/logo.png" alt="logo" style="height: 300px;" />
</div>

<div style="display: flex; flex-direction: column; align-items: center; padding: 8px;">
    <textarea id="benchmarkText" rows="2" style="width: 80%; max-width: 800px; box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);font-size:25px;"></textarea>
    <button id="sendToIframesButton" style="margin-top: 8px; box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);">Send to all</button>
</div>

<div style="display: flex; width: 100%; height: calc(100vh - 420px); gap: 8px; padding: 8px; box-sizing: border-box;">
    <div style="flex: 1; position: relative;">
        <iframe src="/Index?model=gpt-4.1-mini" style="width: 100%; height: 100%; border: none; position: absolute;"></iframe>
    </div>
    <div style="flex: 1; position: relative;">
        <iframe src="/Index?model=gpt-4.1" style="width: 100%; height: 100%; border: none; position: absolute;"></iframe>
    </div>
    <div style="flex: 1; position: relative;">
        <iframe src="/Index?model=o4-mini" style="width: 100%; height: 100%; border: none; position: absolute;"></iframe>
    </div>
    <div style="flex: 1; position: relative;">
        <iframe src="/Index?model=grok-3-mini" style="width: 100%; height: 100%; border: none; position: absolute;"></iframe>
    </div>
    <div style="flex: 1; position: relative;">
        <iframe src="/Index?model=DeepSeek-R1" style="width: 100%; height: 100%; border: none; position: absolute;"></iframe>
    </div>
    <div style="flex: 1; position: relative;">
        <iframe src="/Index?model=gpt-4.1-nano" style="width: 100%; height: 100%; border: none; position: absolute;"></iframe>
    </div>
</div>

<script>
    document.getElementById('sendToIframesButton').addEventListener('click', function() {
        var text = document.getElementById('benchmarkText').value;
        var iframes = document.querySelectorAll('iframe');
        iframes.forEach(function(iframe) {
            var setInputAndClick = function() {
                var contentDoc = iframe.contentWindow.document;
                var messageInput = contentDoc.getElementById('messageInput');
                if (messageInput) {
                    messageInput.value = text;
                    messageInput.classList.add('flash-animation');
                    setTimeout(function() {
                        messageInput.classList.remove('flash-animation');
                    }, 500);
                }
                var sendButton = contentDoc.getElementById('sendButton');
                if (sendButton) {
                    sendButton.click();
                }
            };

            if (iframe.contentWindow && iframe.contentWindow.document.readyState === 'complete') {
                setInputAndClick();
            } else {
                iframe.addEventListener('load', setInputAndClick);
            }
        });
    });
</script>

