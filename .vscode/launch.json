{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch LlmBenchmark",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build LlmBenchmark",
            "program": "${workspaceFolder}/LlmBenchmark/bin/Debug/net9.0/LlmBenchmark.dll",
            "args": [],
            "cwd": "${workspaceFolder}/LlmBenchmark",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/Frame"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Launch LlmBenchmark (with watch)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build LlmBenchmark",
            "program": "dotnet",
            "args": ["watch", "run", "--no-restore"],
            "cwd": "${workspaceFolder}/LlmBenchmark",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
}
